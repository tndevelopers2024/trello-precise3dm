# ==========================================
# Precise3DM Workspace .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
server/node_modules/
client/node_modules/
.pnp
.pnp.js

# Environment Variables & Sensitive Configs
.env
.env.*
*.env
server/.env
client/.env
!.env.example
!server/.env.example
!client/.env.example

# Production Builds & Bundler Output
dist/
dist-ssr/
build/
out/
server/dist/
client/dist/
*.tsbuildinfo

# Test Directories, Playwright & Test Artifacts
test/
tests/
__tests__/
test-results/
playwright-report/
blob-report/
playwright/
.playwright/
test-artifacts/
playwright.config.js
playwright.config.ts
*.test.js
*.test.jsx
*.test.ts
*.test.tsx
*.spec.js
*.spec.jsx
*.spec.ts
*.spec.tsx
trace.zip
*.trace

# Test Mocks & Binary Files
test.zip
test1mb.bin
test*.bin
test*.zip
test*.json
*.tmp
*.temp

# Database Seed Scripts & Data Seed Files
server/scripts/seed*
scripts/seed*
server/scripts/
scripts/
seeds/
server/seeds/
*seed*.js
*seed*.ts
*seed*.json
*.seed.*

# Uploads & User Generated Files
uploads/
server/uploads/*
!server/uploads/.gitkeep
client/public/uploads/

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
.eslintcache

# Cache Directories
.cache/
.parcel-cache/
.turbo/
.next/